{
  "name": "Mukorob PDF \u2014 PDF Reader & Editor \u00b7 Bradz Internal",
  "short_name": "Mukorob PDF",
  "description": "Mukorob PDF \u2014 PDF Reader & Editor for reading, editing, annotating, signing and organising PDFs.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "icons": [
        {
          "src": "icons/mukorob-blue-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "background_color": "#071A33",
  "theme_color": "#0759B5",
  "icons": [
    {
      "src": "icons/mukorob-blue-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/mukorob-blue-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/mukorob-blue-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "version": "0.9.2",
  "shortcuts": [
    {
      "name": "Open PDF",
      "short_name": "Open",
      "url": "./index.html?new=1",
      "icons": [
        {
          "src": "icons/mukorob-blue-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mukorob PDF",
      "short_name": "Mukorob",
      "url": "./index.html",
      "icons": [
        {
          "src": "icons/mukorob-blue-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
